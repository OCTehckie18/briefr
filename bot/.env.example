# Whisper transcription service URL (Docker container)
WHISPER_URL=http://localhost:9000

# Briefr FastAPI backend URL
BACKEND_URL=http://localhost:8000

# Port this bot HTTP server listens on
BOT_PORT=3001

# Maximum duration (minutes) the bot will stay in a meeting before force-leaving
BOT_MAX_DURATION_MINUTES=120

# Guest display name. Google Meet must allow anonymous/guest participants.
BOT_NAME=Briefr Bot

# Set to true to join as a signed-in Google account (requires auth.json).
# Run `node auth-setup.js` once to create auth.json with your bot Gmail session.
# Leave false for fully anonymous/guest mode (works only if the host allows guests).
BOT_USE_GOOGLE_AUTH=false

# HuggingFace Inference API — fallback Whisper transcription when local Docker
# service is unavailable. Get a free token at https://huggingface.co/settings/tokens
# Leave blank to disable fallback (chunks will be skipped if Whisper is down).
HF_TOKEN=
HF_WHISPER_MODEL=openai/whisper-large-v3

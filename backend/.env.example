# MongoDB — Briefr Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=Briefr
MONGO_DB_NAME=briefr

# LLM — Groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
ACADEMIC_LLM_MODEL=qwen/qwen3.6-27b
ACADEMIC_LLM_MAX_TOKENS=3000

# JWT Auth
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_too
JWT_ALGORITHM=HS256

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
BOT_SERVICE_URL=http://localhost:3001
BACKEND_SERVICE_URL=http://localhost:8000
BOT_TOKEN_TTL_MINUTES=180
BOT_LOOKBACK_MINUTES=15

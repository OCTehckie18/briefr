# MongoDB — Breifr Database
MONGO_URI=mongodb+srv://briefr_user:<PASSWORD>@Briefr.<CLUSTER_ID>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=Breifr

# LLM (for later)
LLM_API_KEY=your_key_here
LLM_MODEL=gpt-4-turbo

# JWT Auth (for later)
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_ALGORITHM=HS256

# Email Notifications (for later)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password